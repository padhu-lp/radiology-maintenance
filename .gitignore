# NOTE: patterns must start at column 1. Leading whitespace is part of the
# pattern in git, so an indented rule silently matches nothing.

# Dependencies
node_modules/
.pnp
.pnp.js

# Testing
coverage/

# Production / build output
build/
dist/
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Environment files - these hold the Supabase service role key.
# Broad glob on purpose: catches .env.local, .env.production.local and
# machine-suffixed variants like .env-DESKTOP-7UHL273.local
.env
.env*
!.env.example

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Misc
.DS_Store
Thumbs.db
*.pem
.claude/settings.local.json

# IDE
.vscode/
.idea/
*.swp
*.swo
