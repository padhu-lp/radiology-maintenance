# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase project: Radiology (bmfpmawingyslabxsdia)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Safe to expose to the browser. RLS is what protects your data - see
# migrations/006_enable_rls_rbac.sql
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses RLS entirely. Never prefix with NEXT_PUBLIC_.
# Used by src/app/api/admin/create-user/route.ts
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
